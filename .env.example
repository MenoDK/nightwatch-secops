# Copy to .env, or run `make env`, which does it for you with fresh random values.
# Every value below is a placeholder. None of them is, or ever was, a real credential.

# --- the stores ------------------------------------------------------------------------------------------------------
DB_PASSWORD=replace-with-a-long-random-string

# --- management API key ----------------------------------------------------------------------------------------------
# The API key lets a caller report events and READ everything. It cannot change what the protected application lets
# through: that takes the operators' network plus a code from the authenticator (see TOTP_SECRET below).
# The lab pre-fills "change-me" on the sign-in screen. A real deployment refuses it (APP_ENV=production).
API_KEY=change-me

# --- the audit chain -------------------------------------------------------------------------------------------------
# Keys the HMAC that links every audit row to the one before. Whoever holds it can rewrite history, so it is used for
# nothing else, and a receipt kept OUTSIDE the database (POST /v1/audit/anchor) is what exposes a rewrite. 32+ characters.
AUDIT_CHAIN_SECRET=replace-with-32-random-characters-or-more

# --- inbound webhooks (log shippers, scanners) -----------------------------------------------------------------------
# Signs the time, the route and the exact body. Comma-separated for rotation: the first signs, all of them verify.
WEBHOOK_SECRET=replace-with-16-random-characters-or-more

# --- the operator's second factor ------------------------------------------------------------------------------------
# A base32 TOTP seed (RFC 6238). In a real deployment this lives in the operator's authenticator app and nowhere else;
# the lab shows it on screen, which is exactly why the lab is refused in production.
TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# --- optional: see what the stricter settings do ---------------------------------------------------------------------
# TRAVEL_SUSPENDS=true            suspend the account on impossible travel, instead of only recording it
# HONEY_TRIGGERS_LOCKDOWN=true    a touched trap switches the lockdown on, instead of only blocking the address
# FAIL_CLOSED=true                if Redis cannot be read, refuse traffic instead of letting it through
# APP_PORT=8000

# --- optional: a model for the analyst -------------------------------------------------------------------------------
# Any OpenAI-compatible chat endpoint (a local server works). Without it the local rules do the analysis. With it,
# every suggestion is still checked against the evidence before it is queued, and the model never sees free text from logs.
# ANALYST_URL=http://host.docker.internal:11434/v1
# ANALYST_MODEL=local-model
# ANALYST_KEY=
